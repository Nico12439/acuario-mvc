@model Pez
@{
    ViewData["Title"] = "Registrar pez";
}

<h1>Registrar pez</h1>

<div class="row">
    <div class="col-12 col-md-6">
        <form asp-action="Create" method="post">

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control">
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoAgua" class="form-label"></label>
                <select asp-for="TipoAgua" class="form-select">
                    <option value="">Seleccione...</option>
                    <option value="Agua dulce">Agua dulce</option>
                    <option value="Agua salada">Agua salada</option>
                </select>
                <span asp-validation-for="TipoAgua" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Cantidad" class="form-label"></label>
                <input asp-for="Cantidad" class="form-control">
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Registrar</button>
            <a asp-action="Index" class="btn btn-secondary">Volver</a>
        </form>
    </div>
</div>
